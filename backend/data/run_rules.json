{
  "version": 1,
  "updated": "2026-09-07",
  "principle": "Un chiffre n'est pas une opinion. Il est soit une loi (contrat métier, jamais modulable), soit une mesure (phénomène physique + intervalle de validité), soit une calibration (jeu étiqueté / courbe précision-rappel), soit un budget (quota ou argent). L'intervalle dit encore de quoi on parle ; le défaut est le point d'opération. Un run ne peut bouger que dans l'intervalle. Hors intervalle, ce n'est plus la même règle.",
  "kinds": {
    "loi": {
      "vary": false,
      "label": "Contrat métier. Consigné dans le snapshot, jamais surchargeable."
    },
    "geometrie": {
      "vary": true,
      "label": "Distance ou seuil spatial dérivé d'un phénomène (quai, havre, journée de mer). Intervalle = encore le même phénomène."
    },
    "score": {
      "vary": true,
      "label": "Seuil de classifieur ou de confiance. Cible : le recalibrer sur un Gold, pas le garder par habitude."
    },
    "budget": {
      "vary": true,
      "label": "Quota, timeout, concurrence, argent. Choix opérateur, toujours consigné."
    }
  },
  "profiles": {
    "cdc_default": {
      "label": "Défauts des cahiers des charges — point d'opération actuel.",
      "overrides": {}
    },
    "strict": {
      "label": "Rappel bas : on jette plus, on publie moins. Utile pour une carte « assez confiante ».",
      "overrides": {
        "projects.max_inland_km": 10,
        "projects.min_marine_score": 0.65,
        "projects.gatekeeper_accept": 0.9,
        "projects.gatekeeper_reject": 0.08,
        "formalities.eez_sliver_km": 1.8,
        "formalities.coastal_land_km": 10,
        "formalities.marina_control_m": 500,
        "formalities.listing_coverage_publish": 0.95,
        "formalities.catalog_min_coords": 4,
        "marinas.corridor_radius_nm": 15,
        "marinas.waypoint_radius_nm": 6
      }
    },
    "recall": {
      "label": "Rappel haut : on garde plus de candidats pour la revue. Utile en découverte, pas en publication.",
      "overrides": {
        "projects.max_inland_km": 22,
        "projects.min_marine_score": 0.35,
        "projects.gatekeeper_accept": 0.75,
        "formalities.eez_sliver_km": 3.5,
        "formalities.coastal_land_km": 20,
        "formalities.marina_control_m": 1200,
        "formalities.catalog_min_coords": 2,
        "formalities.listing_coverage_publish": 0.8,
