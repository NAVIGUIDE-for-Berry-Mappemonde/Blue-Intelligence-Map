[Unit]
Description=Blue Intelligence — UI + API (uvicorn, MongoDB local)
After=network-online.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/blue-intelligence-map/backend
Environment=SERVE_FRONTEND=1
ExecStart=/home/ubuntu/blue-intelligence-map/backend/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3
TimeoutStartSec=180
MemoryHigh=2G
MemoryMax=3G

[Install]
WantedBy=multi-user.target
