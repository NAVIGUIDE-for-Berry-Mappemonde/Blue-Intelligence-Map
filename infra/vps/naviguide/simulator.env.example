# Secrets optionnels du simulateur — copier vers
# ~/.config/naviguide/simulator.env (chmod 600).
# Ne pas y coller les clés LLM (NVIDIA / OpenRouter / Anthropic) :
# le simulateur n'a pas de chat ni d'orchestrateur.
#
# Sans Copernicus : vent / vague / courant = fallback interne (suffisant
# pour l'étape 1). Pour du live, reprendre seulement ces deux lignes
# depuis ~/.config/naviguide/naviguide.env — ne pas pointer EnvironmentFile
# vers naviguide.env (ça chargerait les clés LLM dans le process).

#COPERNICUS_USERNAME=
#COPERNICUS_PASSWORD=
