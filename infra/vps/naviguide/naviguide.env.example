# Secrets des services NAVIGUIDE sur le VPS — copier vers
# ~/.config/naviguide/naviguide.env (chmod 600). Lu par les unités systemd
# naviguide-api / naviguide-orchestrator / naviguide-polar (EnvironmentFile).

# Cascade LLM (briefing d'expédition, agents IA, chat polaires) :
# NVIDIA NIM → OpenRouter → Anthropic Claude. Un fournisseur sans clé est sauté.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Modèles optionnels (défauts : deepseek-v4-pro / gpt-4o-mini / claude-opus-4-5)
#NVIDIA_MODEL=
#OPENROUTER_MODEL=
#ANTHROPIC_MODEL=

# Copernicus Marine — vent / vagues / courants live (sans identifiants :
# fallback climatologique)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# StormGlass — météo live de l'agent météo (optionnel)
STORMGLASS_API_KEY=
